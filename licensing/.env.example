# --- Required in production ---
NODE_ENV=production
PUBLIC_URL=https://ragohub.com            # where this server is reachable (https)
SITE_URL=https://ragohub.com              # marketing site (logo link, checkout "back" button)
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_ID=price_...                 # the Rago Hub Premium price (one-time payment)
LICENSE_SIGNING_KEY=...                   # npm run keys
SESSION_SECRET=...                        # npm run keys

# --- Recommended ---
DATABASE_PATH=/data/rago.db               # on a persistent volume
INSTALLER_PATH=/data/RagoHub-Setup.exe    # file served to paying accounts
INSTALLER_VERSION=1.0.0
SUPPORT_URL=https://discord.gg/...        # Discord invite shown for support
RESEND_API_KEY=re_...                     # purchase + password reset emails
MAIL_FROM=Rago <hello@ragohub.com>
TRUST_PROXY=1                             # behind Railway / Render / Fly proxy

# --- Optional ---
SITE_DIR=./site                           # serve the marketing site from this server too
CHECKOUT_CANCEL_URL=https://ragohub.com/#pricing
SELF_SERVICE_RESET_DAYS=0                 # 0 = device reset by support only; 30 = once a month from the dashboard
LICENSE_TOKEN_DAYS=30                     # offline validity of a license token in Rago Hub
PORT=8787

# Variables to set on the host (Railway > service > Variables). Never commit real values.

# --- Required ---
NODE_ENV=production
PUBLIC_URL=https://account.rago-optimizer.com      # this server (https), no trailing slash. rago-production.up.railway.app keeps working for installed apps
SITE_URL=https://rago-optimizer.com                 # the marketing site (Netlify)
DATABASE_URL=postgresql://postgres.xxxx:PASSWORD@aws-0-eu-west-3.pooler.supabase.com:5432/postgres   # Supabase > Connect > Session pooler
STRIPE_SECRET_KEY=sk_test_...               # sk_live_... once live
STRIPE_PRICE_MONTHLY=price_...              # Rago Optimizer Premium, recurring monthly price
STRIPE_PRICE_YEARLY=price_...               # Rago Optimizer Premium, recurring yearly price ($29.99; monthly is $5.99)
STRIPE_WEBHOOK_SECRET=whsec_...
TRUST_PROXY=1

# --- Installer download (Supabase Storage, private bucket "downloads") ---
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=...               # Supabase > Project Settings > API keys > service_role (secret)
INSTALLER_VERSION=1.1.5                     # the number in the uploaded exe name: Rago Optimizer_<number>_x64-setup.exe

# --- Emails and support ---
RESEND_API_KEY=re_...
MAIL_FROM=Rago Optimizer <noreply@rago-optimizer.com>   # a domain verified in Resend
MAIL_REPLY_TO=support@rago-optimizer.com    # where players' replies go (the Zimbra mailbox). Empty = no Reply-To
SUPPORT_URL=https://discord.gg/...

# --- Optional ---
SELF_SERVICE_RESET_DAYS=0                   # 0 = device reset by support only; 30 = once a month from the dashboard
LICENSE_TOKEN_DAYS=30
SUBSCRIPTION_GRACE_DAYS=3                   # a subscriber's app keeps working offline this long past the paid period
AFFILIATE_GOAL=3                            # counted referrals for each reward
AFFILIATE_HOLD_DAYS=0                       # 0 = a referral counts once the player activated the app
AFFILIATE_REWARD_MONTHS=6                   # Premium months given at each goal reached
AFFILIATE_REWARD_MAX=1                      # rewards per affiliate (0 = no limit)
AFFILIATE_MAX_REFERRALS=3                   # players who can use one code (refunded or same-PC ones free their spot)
AFFILIATE_DISCOUNT_PERCENT=5                # % off at checkout with an affiliate code (Stripe promotion code)
AFFILIATE_DISCOUNT_DURATION=once            # once = first payment only, forever = every renewal
STRIPE_PORTAL_LOGIN_URL=                    # Stripe > Settings > Customer portal > login link (cancel without an account)
PRICE_LABEL=                                # shown on the free dashboard: "$5.99 a month or $29.99 a year"
INSTALLER_OBJECT=                           # default downloads/RagoOptimizer-Setup.exe, else the newest .exe in the bucket
LICENSE_SIGNING_KEY=                        # empty = generated once and kept in server_secrets (back it up: npm run admin -- export-keys)
SESSION_SECRET=                             # same
SCRIPTS_SECRET=                             # one long random value (openssl rand -hex 32), also GitHub secret RAGO_SCRIPTS_SECRET; unlocks the app's encrypted Premium scripts (1.1.6+)
CHECKOUT_CANCEL_URL=                        # default: SITE_URL/#pricing
SITE_DIR=                                   # serve the site from this server instead of Netlify
LAUNCH_AT=                                  # before this date (ISO), /signup /buy /download /affiliate send to the site's countdown. Empty in production = 2026-10-10T13:00:00Z
PREVIEW_KEY=                                # same value as the Netlify variable: /acces/<value> lets the team through before LAUNCH_AT (16+ letters and digits)

# --- Discord Pro role (optional; docs/MISE-EN-LIGNE.md, "Le rôle Pro sur Discord") ---
# All five: Premium players link their Discord from their account page, a bot gives them the role and takes it
# back when Premium stops. Without them, the account page says to open a ticket.
DISCORD_CLIENT_ID=                          # Developer Portal > your application > General Information > Application ID
DISCORD_CLIENT_SECRET=                      # OAuth2 > Reset Secret. Redirects: PUBLIC_URL/account/discord/callback
DISCORD_BOT_TOKEN=                          # Bot > Reset Token. Invited with Manage Roles + Create Instant Invite, its role above Pro
DISCORD_GUILD_ID=                           # Developer mode on, right click the server > Copy Server ID
DISCORD_ROLE_ID=                            # Server Settings > Roles > right click Pro > Copy Role ID

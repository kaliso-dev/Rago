# Variables to set on the host (Railway > service > Variables). Never commit real values.

# --- Required ---
NODE_ENV=production
PUBLIC_URL=https://account.ragohub.com      # this server (https), no trailing slash
SITE_URL=https://ragohub.com                # the marketing site (Netlify)
DATABASE_URL=postgresql://postgres.xxxx:PASSWORD@aws-0-eu-west-3.pooler.supabase.com:5432/postgres   # Supabase > Connect > Session pooler
STRIPE_SECRET_KEY=sk_test_...               # sk_live_... once live
STRIPE_PRICE_ID=price_...                   # Rago Hub Premium, one-time price
STRIPE_WEBHOOK_SECRET=whsec_...
LICENSE_SIGNING_KEY=...                     # npm run keys (the app embeds the matching public key)
SESSION_SECRET=...                          # npm run keys
TRUST_PROXY=1

# --- Installer download (Supabase Storage, private bucket "downloads") ---
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=...               # Supabase > Project Settings > API keys > service_role (secret)
INSTALLER_OBJECT=downloads/RagoHub-Setup.exe
INSTALLER_VERSION=1.0.0

# --- Emails and support ---
RESEND_API_KEY=re_...
MAIL_FROM=Rago <hello@ragohub.com>
SUPPORT_URL=https://discord.gg/...

# --- Optional ---
SELF_SERVICE_RESET_DAYS=0                   # 0 = device reset by support only; 30 = once a month from the dashboard
LICENSE_TOKEN_DAYS=30
CHECKOUT_CANCEL_URL=                        # default: SITE_URL/#pricing
SITE_DIR=                                   # serve the site from this server instead of Netlify

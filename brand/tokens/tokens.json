    },
    "line": {
      "line-1": "rgba(10,10,11,.06)",
      "line-2": "rgba(10,10,11,.10)",
      "line-3": "rgba(10,10,11,.16)"
    },
    "red": {
      "red-500": "#D70015",
      "red-400": "#FF3B30",
      "red-600": "#B5000F"

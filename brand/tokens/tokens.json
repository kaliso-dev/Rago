{
  "name": "Rago",
  "version": "1.2.0",
  "fonts": {
    "sans": "Geist",
    "mono": "Geist Mono",
    "license": "SIL OFL 1.1"
  },
  "dark": {
    "ink": {
      "ink-0": "#070708",
      "ink-1": "#0A0A0B",
      "ink-2": "#111113",
      "ink-3": "#17171A",
      "ink-4": "#1F1F23",
      "ink-5": "#2A2A30"
    },
    "text": {
      "text-1": "#F5F5F6",
      "text-2": "#A1A1AA",
      "text-3": "#7C7C86",
      "text-inverse": "#0A0A0B"
    },
    "line": {
      "line-1": "rgba(255,255,255,.06)",
      "line-2": "rgba(255,255,255,.10)",
      "line-3": "rgba(255,255,255,.16)"
    },
    "red": {
      "red-300": "#FF8A82",
      "red-400": "#FF5E55",
      "red-500": "#FF3B30",
      "red-600": "#F2352B",
      "red-700": "#C9221A",
      "red-a12": "rgba(255,59,48,.12)",
      "red-a24": "rgba(255,59,48,.24)",
      "red-gradient": "linear-gradient(100deg, #C9221A 0%, #FF3B30 55%, #FF5E55 100%)"
    },
    "success": {
      "success": "#3DDC97"
    },
    "warning": {
      "warning": "#FFD60A"
    },
    "info": {
      "info": "#5AB8FF"
    },
    "danger": {
      "danger": "#FF3B30"
    },
    "font": {
      "font-sans": "\"Geist\", \"Inter\", \"Segoe UI Variable\", \"Segoe UI\", system-ui, sans-serif",
      "font-mono": "\"Geist Mono\", \"JetBrains Mono\", \"Cascadia Mono\", ui-monospace, monospace"
    },
    "fs": {
      "fs-display": "56px",
      "fs-h1": "36px",
      "fs-h2": "24px",
      "fs-h3": "18px",
      "fs-body": "14px",
      "fs-small": "13px",
      "fs-caption": "12px",
      "fs-overline": "11px",
      "fs-metric": "40px"
    },
    "lh": {
      "lh-display": "1.02",
      "lh-h1": "1.1",
      "lh-h2": "1.2",
      "lh-h3": "1.3",
      "lh-body": "1.55"
    },
    "ls": {
      "ls-display": "-0.035em",
      "ls-h1": "-0.025em",
      "ls-h2": "-0.02em",
      "ls-h3": "-0.01em",
      "ls-caption": "0.02em",
      "ls-overline": "0.12em"
    },
    "space": {
      "space-1": "4px",
      "space-2": "8px",
      "space-3": "12px",
      "space-4": "16px",
      "space-5": "20px",
      "space-6": "24px",
      "space-8": "32px",
      "space-10": "40px",
      "space-12": "48px",
      "space-16": "64px",
      "space-24": "96px"
    },
    "radius": {
      "radius-xs": "8px",
      "radius-sm": "12px",
      "radius-md": "16px",
      "radius-lg": "24px",
      "radius-xl": "32px",
      "radius-2xl": "40px",
      "radius-full": "999px"
    },
    "shadow": {
      "shadow-1": "0 1px 0 rgba(255,255,255,.04) inset, 0 1px 2px rgba(0,0,0,.4)",
      "shadow-2": "0 1px 0 rgba(255,255,255,.05) inset, 0 8px 24px -8px rgba(0,0,0,.6)",
      "shadow-3": "0 1px 0 rgba(255,255,255,.06) inset, 0 24px 64px -16px rgba(0,0,0,.75)"
    },
    "glow": {
      "glow": "0 0 0 1px rgba(255,59,48,.4), 0 8px 32px -6px rgba(255,59,48,.45)"
    },
    "focus": {
      "focus": "0 0 0 2px var(--rg-ink-1), 0 0 0 4px var(--rg-red-500)"
    },
    "ease": {
      "ease-out": "cubic-bezier(.16, 1, .3, 1)",
      "ease-in-out": "cubic-bezier(.65, 0, .35, 1)",
      "ease-spring": "cubic-bezier(.34, 1.56, .64, 1)"
    },
    "dur": {
      "dur-instant": "90ms",
      "dur-fast": "160ms",
      "dur-base": "240ms",
      "dur-slow": "420ms",
      "dur-pulse": "1600ms"
    }
  },
  "light_overrides": {
    "ink": {
      "ink-0": "#EDEDEF",
      "ink-1": "#F7F7F8",
      "ink-2": "#FFFFFF",
      "ink-3": "#F1F1F3",
